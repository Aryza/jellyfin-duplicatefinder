<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.DuplicateFinder</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.DuplicateFinder</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin 12.0.x targets net10.0 -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc1" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the unified config/report page HTML as a resource served by Jellyfin -->
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prevent the SDK from compiling test sources that live under tests/ -->
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal helpers (NormaliseTitle, JaroWinkler, PartNumber,
         MatchesTitleAndYear, UnionFind, …) to the xUnit test project. -->
    <InternalsVisibleTo Include="Jellyfin.Plugin.DuplicateFinder.Tests" />
  </ItemGroup>

</Project>
